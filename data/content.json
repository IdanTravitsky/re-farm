behavior":"prop","no_corpse":true},"bryan_down":{"model":"bryan","clips":"npc","behavior":"prop","pose":"collapse","hide":["shotgun","pistol","handset","cellphone"],"no_corpse":true},"searchlight":{"model":"package","clips":"npc","behavior":"prop","invisible":true,"no_corpse":true,"lamps":[{"at":[0,0,0],"cone":22,"range":30,"tilt":-0.12,"color":[0.8,0.9,1.0],"power":3.5}]},"bryan_sit":{"model":"bryan","clips":"bench","behavior":"prop","hide":["shotgun","pistol","handset"],"no_corpse":true},"bryan_phone":{"model":"bryan","clips":"npc","behavior":"prop","pose":"phone","hide":["shotgun","pistol","cellphone"],"no_corpse":true},"bryan_reach":{"model":"bryan","clips":"npc","behavior":"prop","pose":"reach","hide":["shotgun","pistol","handset","cellphone"],"no_corpse":true},"valve_wheel":{"model":"valve_handle","clips":"npc","behavior":"prop","no_corpse":true},"truck_wreck":{"model":"truck_fener","clips":"npc","behavior":"prop","radius":1.0,"no_corpse":true,"lamps":[{"at":[0.0,0.0,2.8],"range":4.5,"color":[0.5,0.56,0.75],"power":0.75,"self":true}]}},"files":{"farm_diary":{"title":"KATIE FENER'S DIARY","pages":[["Dec 2","Shadow won't eat. She's been down by","the south fence all day, digging at","something in the snow. Came back with","her muzzle all red. Daryl says rabbit."],["Dec 3","Black trucks on Route 6 again. A red","and white sign on the doors, like an","umbrella. Two men asked Daryl about the","well water. He ran them off the porch."],["Dec 4","Shadow bit Daryl when he went to chain","her up. She's never so much as growled","at him. He's got a fever now, and his","hand looks wrong. Veins gone dark."],["Dec 5","Daryl won't wake up properly. He just","sits on the bed and breathes.","I'm going to walk to the Kowalskis'","and use their phone. Ours keeps cutting","out. If you find this, I'm sorry."]]},"umbrella_manifest":{"title":"UMBRELLA - TRANSFER MANIFEST","pages":[["ITEM: B7 (1 unit, cold chain)","FROM: St. George's Hospital, Denver","TO: Lab 4, Raccoon City General,","     Tower B, Floor 28","COURIER: contracted (civilian)"],["NOTE (handwritten):","Courier's car went off Route 6.","Tracker still moving - on FOOT?","Recover the unit. Courier is","not a priority."],["NOTE (another hand):","If B7 doesn't reach Lab 4 by 06:00","there won't be a Lab 4. Or a city.","Carl says the elevator's dead.","Stairs to 24, bridge to Tower B."]]},"dispatch_log":{"title":"RACCOON CO. SHERIFF - DISPATCH","pages":[["23:12  CALL, ROUTE 6 MILE 14","Caller reports a dog \"eating a deer alive\" on the shoulder. Unit 4 (Wilson) advised."],["23:47  CALL, FENER FARM","Neighbor reports screaming. Line cut off. No unit available. Logged."],["00:31  NOTE","Black box trucks, no plates, at the Route 6 pump station again. Company says water testing.","","Told to leave it alone. By who, it doesn't say."],["00:52  CALL, ROUTE 6","Caller reports he hit a woman with his car. Unit 4 responding.","","Wilson, radio in when you get there. You haven't checked in since midnight."]]},"fridge_note":{"title":"NOTE ON THE FRIDGE","pages":[["Lily -","Mommy is sick so I'm going to lie down. Stay in your room and keep the door shut, even if I knock.","","If I knock and don't say the password, DON'T open it.","","Password is \"pancakes.\" Love you bug."]]},"work_order":{"title":"R.C. WATER DEPT. - WORK ORDER","pages":[["WO 5521  PRIORITY: URGENT","Storm drain east, cistern 3. Flood gate stuck shut after a pressure spike. Valve wheel removed for repair, see crew office."],["FIELD NOTE","Something's living in the cistern. Big. Hodges went down with a flashlight at 11 and didn't come back up.","","Not going back down without the cops."]]},"maint_log":{"title":"CISTERN 3 - MAINTENANCE LOG","pages":[["DEC 4","Found a homeless guy asleep by the flood gate. Huge, bald, wouldn't talk. Told him to move on.","","He was still there at end of shift. Hadn't moved an inch."],["DEC 5","Rats everywhere. Hundreds. All going the same way, toward the cistern, like they're being called.","","The big guy's stomach was moving. I swear to God it was moving."],["DEC 6","Took the valve wheel so nobody opens that gate. Whatever he is, he stays on the other side.","","Ladder out of the cistern comes up on East 12th, by the hospital."]]},"guard_log":{"title":"CAR PARK B2 - SECURITY LOG","pages":[["01:10","Ambulances stopped coming in. Radio says the ER is sealed. Nobody tells security anything."],["01:45","Lab 4 called down. A courier might come through B2 with a cooler. Let him up, don't ask questions.","","Card for the stairwell is on my key hook. Elevators are locked out."],["02:20","Something is walking around on B2 in the dark. It's not a person. I'm going up."]]},"lab4_memo":{"title":"MEMO: LAB 4 / B7 PROTOCOL","pages":[["FROM: CARL T. (LAB 4)","TO: ALL FLOOR STAFF","","Tower A stairwell is compromised above 14. Route anything for Lab 4 through the 24F skybridge."],["RE: B7","B7 is the only neutralizer sample outside Denver. Once it is in the synthesizer we can make enough for the city in six hours.","","If the courier arrives infected, take the unit first. Then deal with the courier."]]},"b7_notes":{"title":"LAB 4 - RESEARCH NOTES","pages":[["THE AGENT","It doesn't kill the host. It rewires it. The body keeps growing whatever the agent needs: mouths, limbs, more bodies.","","Hosts that die near each other merge."],["B7","Stops the rewiring in cell culture within minutes. In a living host: unknown.","","Cold chain above 8 C for more than two hours and it's useless."],["NOTE, 03:40","If the courier makes it, give him the first dose. Whatever he has become, he carried it here."]]},"michelle_voicemail":{"title":"SAVED MESSAGE - MICHELLE","pages":[["SAVED  11:02 PM","\"Hey. It's me. You're driving that stupid mountain road again, aren't you.\"","","\"Call me when you stop. I don't care what time it is.\""],["(cont.)","\"The heater in the car is broken, remember. Wear the hat.\"","","\"...Drive safe. I love you. Okay. Bye.\""]]}},"journey":{"title":"RACCOON COUNTY